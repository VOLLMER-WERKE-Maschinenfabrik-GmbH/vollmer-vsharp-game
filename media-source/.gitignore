# Nur strukturierte Autorenquellen werden versioniert; Rohbilder und Master bleiben ausgeschlossen.
!/.gitignore
!/assets/
!/plan/
!/zone-authoring/
/assets/*
!/assets/*.meta.json
!/assets/README.md
/plan/*
!/plan/delivery-list.csv
/zone-authoring/*
!/zone-authoring/*.zones.json
!/zone-authoring/.gitkeep